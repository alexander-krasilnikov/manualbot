# Copy to `.env` to change anything. Every value has the default shown, so the stack also starts without a `.env`.

# Couchbase Server administrator (web console at http://localhost:18091).
CB_ADMIN_USER=Administrator
CB_ADMIN_PASSWORD=manualbot-admin

# The account Sync Gateway uses to read and write the bucket.
SG_BUCKET_USER=sync_gateway
SG_BUCKET_PASSWORD=manualbot-gateway

# The accounts of the iPads: ipad1, ipad2 and ipad3, all with this password.
IPAD_PASSWORD=manualbot-ipad

# Ports on this machine. 4984 is the one iPads connect to; 4985 (admin) is only ever published on 127.0.0.1. The console is
# on 18091 rather than 8091, so that it does not collide with a Couchbase Server already running here.
SG_PUBLIC_PORT=4984
SG_ADMIN_PORT=4985
CB_CONSOLE_PORT=18091
